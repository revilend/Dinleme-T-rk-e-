# ==========================================================
#  🎧 Turk Tili A1 — Dinleme boti sozlamalari
#  Ushbu fayldan nusxa olib `.env` yarating:  cp .env.example .env
# ==========================================================

# @BotFather -> /newbot orqali olingan token (MAJBURIY)
BOT_TOKEN=1234567890:AAE-misol-token-almashtiring

# Admin panelga ruxsat berilgan Telegram ID raqamlar (vergul bilan ajratilgan).
# O'z ID raqamingizni @userinfobot orqali bilib oling. (MAJBURIY)
ADMIN_IDS=123456789,987654321

# Ixtiyoriy: SQLite baza fayli yo'li (standart: ./bot.db)
# DB_PATH=bot.db

# Ixtiyoriy: HTTP healthcheck porti (Render o'zi PORT beradi, standart 10000)
# PORT=10000

# Ixtiyoriy: backup izohidagi vaqt mintaqasi (standart: 5 = GMT+5)
# TZ_OFFSET_HOURS=5
